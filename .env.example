# Copy to .env and fill in. Everything has a working default without secrets.

# Optional LLM for report generation. If unset, the system uses the deterministic
# local report generator (extractive, evidence-cited). Do NOT commit a real key.
# LLM_PROVIDER=openai            # openai | gemini | none (default: none)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...

# Runtime settings (all optional; sane defaults in src/app/config.py)
# APP_DEVICE=auto                # auto | cpu | cuda
# APP_DATA_DIR=data
# APP_INDEX_DIR=data/index
# APP_MAX_UPLOAD_MB=10
