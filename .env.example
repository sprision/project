# ==============================================================================
# InspectAI Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#     copy .env.example .env
#
# All variables have safe defaults. No external API keys are required for
# full deterministic operation (PaDiM vision + Hybrid RAG + Extractive Reports).
# ==============================================================================

# Runtime Device (auto | cpu | cuda)
APP_DEVICE=auto

# Application Storage Paths
APP_DATA_DIR=data
APP_INDEX_DIR=data/index
APP_RUNS_DIR=runs
APP_MAX_UPLOAD_MB=10

# Offline Mode Flag for HuggingFace / Transformers
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional LLM Enhancement (default: none -> 100% deterministic local reports)
# If enabled, LLM provides conversational synthesis grounded in retrieved evidence.
APP_LLM_PROVIDER=none
# APP_OPENAI_API_KEY=sk-...
# APP_OPENAI_MODEL=gpt-4o-mini
# APP_GEMINI_API_KEY=...
